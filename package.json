{
  "name": "photocull",
  "productName": "PhotoCull",
  "version": "0.8.0",
  "private": true,
  "description": "Local photo culling, editable RAW development, external-editor hand-off and image export",
  "scripts": {
    "start": "tauri dev",
    "web": "node src/backend.cjs --web --port 5173",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/ui-smoke.cjs",
    "benchmark": "node scripts/benchmark.cjs",
    "stage": "node scripts/stage-backend.cjs",
    "build": "node scripts/stage-backend.cjs && tauri build --config src-tauri/tauri.bundle.conf.json",
    "perf:audit": "node scripts/performance-audit.cjs",
    "tauri": "tauri",
    "notices": "node scripts/notices.cjs"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.10",
    "exiftool-vendored": "^39.1.0",
    "libraw-wasm-nothread": "1.6.0-nothread.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "playwright-core": "^1.58.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ficaa1/photocull.git"
  },
  "homepage": "https://www.filipbiljic.com/photocull/"
}
